# Giscus — create a repository category at https://giscus.app
NEXT_PUBLIC_GISCUS_REPO=YOUR_GITHUB_USERNAME/YOUR_REPO_NAME
NEXT_PUBLIC_GISCUS_REPO_ID=YOUR_GISCUS_REPO_ID
NEXT_PUBLIC_GISCUS_CATEGORY=Blog Comments
NEXT_PUBLIC_GISCUS_CATEGORY_ID=YOUR_GISCUS_CATEGORY_ID

# Optional Codex Pets 8×9 spritesheet. Defaults to Noir Webling.
NEXT_PUBLIC_PET_SPRITESHEET_URL=https://codexpets.org/pets/noir-webling/spritesheet.webp

# Optional OpenTelemetry backend (for example, Grafana Cloud's free tier).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Optional public visitor count in “Stats for nerds”. Server-only Vercel token.
VERCEL_TOKEN=
# VERCEL_PROJECT_ID is injected automatically on Vercel; set it for local testing.
VERCEL_PROJECT_ID=
# Optional for team-owned projects.
VERCEL_TEAM_ID=
